DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=0
# Noms d'hôte / IP autorisés, séparés par des virgules (ex. IP du serveur sur le réseau local)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour les formulaires (avec le schéma), ex. http://192.168.1.12:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Fermeture de session après ce nombre d'heures d'inactivité (4 au minimum)
DJANGO_SESSION_HOURS=8
# Mettre à 1 uniquement derrière HTTPS
DJANGO_SECURE_COOKIES=0
POSTGRES_DB=secureqcm
POSTGRES_USER=secureqcm
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# HTTPS (docs/HTTPS.md) : retirer les « # », mettre DJANGO_SECURE_COOKIES=1 et une origine https://
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# SITE_ADDRESS=qcm.exemple.sn
# GUNICORN_CMD_ARGS="--workers 4"
